
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Battle Royale 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;font-family:Arial,sans-serif;background:#83d9ff}
canvas{display:block}
#hud{position:fixed;z-index:3;top:12px;left:12px;color:white;
text-shadow:2px 2px 3px #222;font-weight:bold;pointer-events:none}
.panel{background:#17334ddd;padding:10px 14px;border-radius:12px;margin-bottom:7px}
#healthOuter{width:190px;height:14px;background:#5d2530;border-radius:9px;overflow:hidden;margin-top:6px}
#health{height:100%;width:100%;background:#43e36e;transition:width .2s}
#crosshair{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);
color:white;font-size:25px;text-shadow:0 0 4px black;pointer-events:none}
#message{position:fixed;z-index:5;inset:0;display:flex;align-items:center;
justify-content:center;text-align:center;background:#10243cbb;color:white;padding:20px}
#message.hidden{display:none}
.card{max-width:420px;background:#17334df2;border:2px solid #ffffff55;
padding:28px;border-radius:20px}
h1{margin-top:0;color:#ffe66d}
button{border:0;border-radius:12px;background:#ffbd38;color:#27243b;
font-weight:900;padding:12px 18px;font-size:16px;touch-action:none}
#mobile{display:none;position:fixed;z-index:4;bottom:18px;left:12px;right:12px;
justify-content:space-between;align-items:end;pointer-events:none}
.pad{display:grid;grid-template-columns:repeat(3,46px);gap:5px}
.pad button,#mobile .action{width:46px;height:46px;padding:0;background:#17334ddd;color:white}
#mobile .action{width:70px;height:62px;background:#ffbd38;color:#222}
#mobile button{pointer-events:auto}
#help{font-size:12px;line-height:1.5}
@media(max-width:800px){#mobile{display:flex}#help{display:none}#healthOuter{width:145px}}
</style>
</head>
<body>
<div id="hud">
  <div class="panel">
    <div>🏝️ BATTLE ROYALE</div>
    <div id="stats">Bots: 12 · Kills: 0</div>
    <div id="healthOuter"><div id="health"></div></div>
    <div id="hpText">Leben: 100</div>
  </div>
  <div class="panel" id="help">
    WASD: Bewegen<br>
    Maus: Umsehen · Linksklick: Schießen<br>
    Leertaste: Springen · R: Neustart
  </div>
</div>
<div id="crosshair">+</div>
<div id="mobile">
  <div class="pad">
    <span></span><button data-key="w">▲</button><span></span>
    <button data-key="a">◀</button><button data-key="s">▼</button>
    <button data-key="d">▶</button>
  </div>
  <div>
    <button class="action" id="shoot">🔫 SCHUSS</button>
    <button class="action" id="jump">⬆ SPRUNG</button>
  </div>
</div>
<div id="message">
  <div class="card">
    <h1>🏆 BATTLE ROYALE</h1>
    <p>Überlebe auf der Insel, besiege die Bots und bleib in der sicheren Zone!</p>
    <p>Bewege dich mit WASD. Ziele mit der Maus und schieße mit Linksklick.</p>
    <button id="start">SPIEL STARTEN</button>
    <p style="font-size:12px">Für die 3D-Grafik ist eine Internetverbindung erforderlich.</p>
  </div>
</div>

<script type="importmap">
{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js"}}
</script>
<script type="module">
import * as THREE from "three";

const scene=new THREE.Scene();
scene.background=new THREE.Color("#83d9ff");
scene.fog=new THREE.Fog("#83d9ff",65,150);

const camera=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.1,300);
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight("#ffffff","#557b42",2.2));
const sun=new THREE.DirectionalLight("#fff4d6",2.5);
sun.position.set(25,45,20);
sun.castShadow=true;
sun.shadow.mapSize.set(1024,1024);
scene.add(sun);

const material=c=>new THREE.MeshStandardMaterial({color:c,roughness:1});
const ground=new THREE.Mesh(new THREE.PlaneGeometry(220,220),material("#67c951"));
ground.rotation.x=-Math.PI/2;
ground.receiveShadow=true;
scene.add(ground);

const obstacles=[];
function box(x,y,z,w,h,d,color){
  const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material(color));
  mesh.position.set(x,y,z);
  mesh.castShadow=true;
  mesh.receiveShadow=true;
  scene.add(mesh);
  obstacles.push({x,z,r:Math.max(w,d)*.55});
  return mesh;
}

// Bunte Häuser mit Dächern
for(let i=0;i<16;i++){
  const angle=i*2.399;
  const radius=18+(i%4)*13;
  const x=Math.cos(angle)*radius,z=Math.sin(angle)*radius;
  const colors=["#ffbd55","#ff6f91","#8d9dff","#fff07c"];
  box(x,2,z,5,4,5,colors[i%4]);
  const roof=new THREE.Mesh(new THREE.ConeGeometry(4.3,2.5,4),material("#e34d5d"));
  roof.position.set(x,5.2,z);
  roof.rotation.y=Math.PI/4;
  roof.castShadow=true;
  scene.add(roof);
}

// Bäume
for(let i=0;i<110;i++){
  const x=(Math.random()-.5)*180,z=(Math.random()-.5)*180;
  if(Math.hypot(x,z)<12)continue;
  const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.25,.4,2,7),material("#89542d"));
  trunk.position.set(x,1,z);
  trunk.castShadow=true;
  scene.add(trunk);
  const leaves=new THREE.Mesh(new THREE.SphereGeometry(1.5,9,8),
    material(["#26a65b","#42be54","#77cf49"][i%3]));
  leaves.position.set(x,2.8,z);
  leaves.scale.set(1.15,1.3,1.15);
  leaves.castShadow=true;
  scene.add(leaves);
  obstacles.push({x,z,r:1});
}

// Felsen
for(let i=0;i<25;i++){
  const x=(Math.random()-.5)*160,z=(Math.random()-.5)*160;
  if(Math.hypot(x,z)<12)continue;
  const rock=new THREE.Mesh(new THREE.DodecahedronGeometry(1+Math.random()*2,0),
    material("#8b9a9d"));
  rock.position.set(x,.8,z);
  rock.scale.y=.7;
  rock.castShadow=true;
  scene.add(rock);
}

function character(color){
  const group=new THREE.Group();
  const body=new THREE.Mesh(new THREE.BoxGeometry(.85,1.15,.5),material(color));
  body.position.y=1.3;
  body.castShadow=true;
  group.add(body);
  const head=new THREE.Mesh(new THREE.SphereGeometry(.34,12,10),material("#ffd0a0"));
  head.position.y=2.12;
  head.castShadow=true;
  group.add(head);
  const hair=new THREE.Mesh(new THREE.SphereGeometry(.36,10,8),material("#49342b"));
  hair.position.y=2.32;
  hair.scale.set(1,.6,1);
  group.add(hair);
  for(const side of [-1,1]){
    const leg=new THREE.Mesh(new THREE.BoxGeometry(.3,.75,.34),material("#344e9b"));
    leg.position.set(side*.23,.38,0);
    group.add(leg);
  }
  scene.add(group);
  return group;
}

let player,bots,keys,health,kills,zoneRadius,gameOver,started;
let yaw=0,pitch=.15,vertical=0,onGround=true,fireCooldown=0;
let elapsed=0;
const raycaster=new THREE.Raycaster();
const center=new THREE.Vector2(0,0);
const clock=new THREE.Clock();

const zone=new THREE.Mesh(
  new THREE.RingGeometry(1,1.06,96),
  new THREE.MeshBasicMaterial({color:"#35e9ff",side:THREE.DoubleSide})
);
zone.rotation.x=-Math.PI/2;
zone.position.y=.12;
scene.add(zone);

function newGame(){
  for(const b of bots||[])scene.remove(b.model);
  health=100;kills=0;zoneRadius=85;gameOver=false;started=true;
  yaw=0;pitch=.15;vertical=0;onGround=true;elapsed=0;
  keys=new Set();
  if(player)scene.remove(player);
  player=character("#20c9e8");
  player.position.set(0,0,0);
  bots=[];
  for(let i=0;i<12;i++){
    const angle=i*Math.PI*2/12;
    const r=20+Math.random()*35;
    const model=character(["#ff5e62","#ffb62e","#b46bff","#52e69a"][i%4]);
    model.position.set(Math.cos(angle)*r,0,Math.sin(angle)*r);
    bots.push({model,hp:100,shoot:1+Math.random()*2,alive:true});
  }
  document.getElementById("message").classList.add("hidden");
  updateHUD();
}

function updateHUD(){
  document.getElementById("health").style.width=Math.max(0,health)+"%";
  document.getElementById("hpText").textContent="Leben: "+Math.max(0,Math.ceil(health));
  document.getElementById("stats").textContent=
    "Bots: "+bots.filter(b=>b.alive).length+" · Kills: "+kills+
    " · Zone: "+Math.round(zoneRadius);
}

function endGame(won){
  if(gameOver)return;
  gameOver=true;
  document.exitPointerLock?.();
  const msg=document.getElementById("message");
  msg.classList.remove("hidden");
  msg.querySelector("h1").textContent=won?"🏆 SIEG!":"💥 GAME OVER";
  msg.querySelector("p").textContent=won?
    "Du hast alle Bots besiegt! Kills: "+kills:
    "Versuch es noch einmal! Kills: "+kills;
  document.getElementById("start").textContent="NOCHMAL SPIELEN";
}

function blocked(x,z){
  return obstacles.some(o=>Math.hypot(x-o.x,z-o.z)<o.r+.7);
}

function shoot(){
  if(!started||gameOver||fireCooldown>0)return;
  fireCooldown=.25;
  raycaster.setFromCamera(center,camera);
  const targets=bots.filter(b=>b.alive).map(b=>b.model);
  const hits=raycaster.intersectObjects(targets,true);
  if(!hits.length)return;
  let hit=hits[0].object;
  let model=hit;
  while(model.parent&&model.parent!==scene)model=model.parent;
  const bot=bots.find(b=>b.model===model);
  if(!bot)return;
  bot.hp-=50;
  bot.model.traverse(obj=>{
    if(obj.material&&obj.material.color)obj.material.color.set("#ff4444");
  });
  setTimeout(()=>{
    if(bot.alive)bot.model.traverse(obj=>{
      if(obj.material&&obj.material.color){
        // Die Farbe wird für den Treffer kurz aufgehellt.
        obj.material.color.set(obj.geometry?.type==="SphereGeometry"?"#ffd0a0":"#ff5e62");
      }
    });
  },100);
  if(bot.hp<=0){
    bot.alive=false;
    scene.remove(bot.model);
    kills++;
    if(bots.every(b=>!b.alive))endGame(true);
  }
  updateHUD();
}

function movePlayer(dt){
  let forward=0,side=0;
  if(keys.has("w")||keys.has("arrowup"))forward++;
  if(keys.has("s")||keys.has("arrowdown"))forward--;
  if(keys.has("a")||keys.has("arrowleft"))side--;
  if(keys.has("d")||keys.has("arrowright"))side++;
  const len=Math.hypot(forward,side)||1;
  forward/=len;side/=len;
  const speed=10;
  const dx=(-Math.sin(yaw)*forward+Math.cos(yaw)*side)*speed*dt;
  const dz=(-Math.cos(yaw)*forward-Math.sin(yaw)*side)*speed*dt;
  if(!blocked(player.position.x+dx,player.position.z))player.position.x+=dx;
  if(!blocked(player.position.x,player.position.z+dz))player.position.z+=dz;
  player.position.x=THREE.MathUtils.clamp(player.position.x,-99,99);
  player.position.z=THREE.MathUtils.clamp(player.position.z,-99,99);
  player.rotation.y=yaw;

  vertical-=20*dt;
  player.position.y+=vertical*dt;
  if(player.position.y<=0){
    player.position.y=0;vertical=0;onGround=true;
  }
}

function moveBots(dt){
  for(const bot of bots){
    if(!bot.alive)continue;
    const dx=player.position.x-bot.model.position.x;
    const dz=player.position.z-bot.model.position.z;
    const distance=Math.hypot(dx,dz);
    bot.model.rotation.y=Math.atan2(-dx,-dz);

    if(distance>3){
      const step=2.5*dt;
      const nx=bot.model.position.x+dx/distance*step;
      const nz=bot.model.position.z+dz/distance*step;
      if(!blocked(nx,nz)){
        bot.model.position.x=nx;
        bot.model.position.z=nz;
      }
    }else{
      bot.shoot-=dt;
      if(bot.shoot<=0){
        bot.shoot=1.4+Math.random()*1.5;
        health=Math.max(0,health-5);
        if(health<=0)endGame(false);
      }
    }
  }
}

function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),.05);
  fireCooldown=Math.max(0,fireCooldown-dt);

  if(started&&!gameOver){
    elapsed+=dt;
    if(elapsed>12)zoneRadius=Math.max(12,85-(elapsed-12)*.55);
    zone.scale.set(zoneRadius,zoneRadius,1);
    if(Math.hypot(player.position.x,player.position.z)>zoneRadius){
      health=Math.max(0,health-7*dt);
      if(health<=0)endGame(false);
    }
    movePlayer(dt);
    moveBots(dt);

    const target=new THREE.Vector3(
      player.position.x,1.45+player.position.y,player.position.z
    );
    const distance=6.5;
    camera.position.set(
      player.position.x+Math.sin(yaw)*distance,
      player.position.y+3.5+pitch*4,
      player.position.z+Math.cos(yaw)*distance
    );
    camera.lookAt(target);
    updateHUD();
  }
  renderer.render(scene,camera);
}
animate();

document.getElementById("start").addEventListener("click",()=>{
  newGame();
  if(innerWidth>800)renderer.domElement.requestPointerLock?.();
});
renderer.domElement.addEventListener("click",()=>{
  if(started&&!gameOver&&innerWidth>800&&document.pointerLockElement!==renderer.domElement)
    renderer.domElement.requestPointerLock?.();
});
document.addEventListener("mousemove",e=>{
  if(document.pointerLockElement===renderer.domElement){
    yaw-=e.movementX*.0025;
    pitch=THREE.MathUtils.clamp(pitch+e.movementY*.0015,-.1,.65);
  }
});
addEventListener("keydown",e=>{
  keys.add(e.key.toLowerCase());
  if(e.code==="Space"&&onGround&&started&&!gameOver){
    vertical=8;onGround=false;
  }
  if(e.key.toLowerCase()==="r")newGame();
  if(e.code==="Space"||e.key.startsWith("Arrow"))e.preventDefault();
});
addEventListener("keyup",e=>keys.delete(e.key.toLowerCase()));
addEventListener("blur",()=>keys?.clear());

document.querySelectorAll("[data-key]").forEach(button=>{
  const key=button.dataset.key;
  const down=e=>{e.preventDefault();keys.add(key)};
  const up=e=>{e.preventDefault();keys.delete(key)};
  button.addEventListener("pointerdown",down);
  ["pointerup","pointercancel","pointerleave"].forEach(t=>button.addEventListener(t,up));
});
document.getElementById("shoot").addEventListener("pointerdown",e=>{
  e.preventDefault();shoot();
});
document.getElementById("jump").addEventListener("pointerdown",e=>{
  e.preventDefault();
  if(onGround){vertical=8;onGround=false;}
});
addEventListener("mousedown",e=>{
  if(e.button===0&&started&&!gameOver&&innerWidth>800)shoot();
});
addEventListener("resize",()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
